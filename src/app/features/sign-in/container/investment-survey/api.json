{
  "components": {
    "responses": {},
    "schemas": {
      "Asset": {
        "description": "Investment asset in a portfolio",
        "example": {
          "assetClass": "Equity",
          "currency": "USD",
          "currentPrice": 235.45,
          "expectedYield": 0.068,
          "market": "US",
          "name": "Vanguard Total Stock Market ETF",
          "priceDate": "2023-04-12",
          "symbol": "VTI",
          "units": 25.48,
          "weight": 0.6
        },
        "properties": {
          "assetClass": {
            "description": "Asset class category",
            "enum": ["Equity", "Bond", "Commodity", "Cash", "Real Estate"],
            "type": "string"
          },
          "currency": {
            "description": "Price currency",
            "example": "USD",
            "type": "string"
          },
          "currentPrice": {
            "description": "Current market price",
            "format": "float",
            "type": "number"
          },
          "expectedYield": {
            "description": "Expected annual yield",
            "format": "float",
            "type": "number"
          },
          "market": {
            "description": "Market where the asset is traded",
            "example": "US",
            "type": "string"
          },
          "name": {
            "description": "Full name of the asset",
            "type": "string"
          },
          "priceDate": {
            "description": "Date of current price",
            "format": "date",
            "type": "string"
          },
          "symbol": {
            "description": "Asset ticker symbol",
            "type": "string"
          },
          "units": {
            "description": "Number of units held",
            "format": "float",
            "type": "number"
          },
          "weight": {
            "description": "Portfolio allocation weight (0.0-1.0)",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "name",
          "assetClass",
          "weight",
          "currentPrice",
          "units",
          "currency",
          "market",
          "priceDate",
          "expectedYield"
        ],
        "title": "Asset",
        "type": "object"
      },
      "ChatResponse": {
        "description": "Response from the AI chat interface",
